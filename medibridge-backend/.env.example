PORT=5000
NODE_ENV=production
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER/medibridge
# For tests (a separate database is wiped on every run!)
MONGO_URI_TEST=mongodb://127.0.0.1:27017/medibridge_test
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_URL=https://YOUR-PROJECT.vercel.app
# The deployed MediBridge Preview and production aliases are also allowlisted
# exactly in src/config/env.js; no wildcard Vercel origins are accepted.
AUTH_COOKIE_NAME=medibridge_auth
AUTH_COOKIE_DAYS=7
UPLOAD_DIR=uploads
